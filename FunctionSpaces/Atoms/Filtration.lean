module

public import ApproximationSpaces.Projection
public import FunctionSpaces.Lp.Inclusion
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.Real
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.AEMeasurable
public import Mathlib.Probability.Process.Filtration

/-!
# Filtration schemes: Haar wavelets and martingale differences

Let `ℱ_0 ≤ ℱ_1 ≤ ⋯` be a filtration of sub-σ-algebras on a finite measure space.  The
**filtration scheme** in `L_p(μ)` (`MeasureTheory.Filtration.scheme`) has as approximants of
complexity `n ≥ 1` the `ℱ_j`-measurable functions, `j = ⌊log₂ n⌋`: complexity `2^j` buys
measurability at level `j`.  For the dyadic filtration of `[0, 1)`, `ℱ_j` is generated by the
dyadic intervals of length `2^(-j)`, and the approximants of complexity `2^j` are the step
functions on these `2^j` intervals: the scheme of the **Haar system**.

The conditional expectations `E[· | ℱ_j]` are projections onto the approximants, of norm at
most `1` on every `L_p`, `1 ≤ p ≤ ∞` (Mathlib's conditional Jensen inequality
`MeasureTheory.eLpNorm_condExp_le_eLpNorm`); `MeasureTheory.Lp.condExpLp` makes them bounded
linear operators.  So the filtration scheme is a projection scheme with bound `1`
(`MeasureTheory.Filtration.projectionScheme`), its dyadic blocks are the **martingale
differences** `E[f | ℱ_{k+1}] - E[f | ℱ_k]`, and for `s > 0` (`memApprox_iff_martingale`):

`f ∈ A^s_q(L_p, ℱ)`  iff  `‖E[f | ℱ_0]‖_p + ‖(2^(ks) ‖E[f | ℱ_{k+1}] - E[f | ℱ_k]‖_p)_k‖_{ℓ_q} < ∞`,

provided the approximants are dense in `L_p` (for the dyadic filtration: `p < ∞` and `ℱ`
generating the Borel σ-algebra, by martingale convergence).  For the Haar system,
`E[f | ℱ_{k+1}] - E[f | ℱ_k]` is the part of the Haar expansion of `f` at level `k`.
-/

@[expose] public section

open Filter Topology MeasureTheory
open scoped ENNReal

namespace MeasureTheory

variable {α : Type*} {m m0 : MeasurableSpace α} {p : ℝ≥0∞} [Fact (1 ≤ p)] {μ : Measure α}
  [IsFiniteMeasure μ]

namespace Lp

variable (m) in

/-- The **conditional expectation** `E[· | m]` on `L_p(μ)`, as a real-linear map. -/
noncomputable def condExpLpLinear : Lp ℂ p μ →ₗ[ℝ] Lp ℂ p μ where
  toFun f := ((Lp.memLp f).condExp Fact.out).toLp (μ[(f : α → ℂ) | m])
  map_add' f g := by
    ext1
    have hfi := (Lp.memLp f).integrable (Fact.out : 1 ≤ p)
    have hgi := (Lp.memLp g).integrable (Fact.out : 1 ≤ p)
    filter_upwards [MemLp.coeFn_toLp ((Lp.memLp (f + g)).condExp Fact.out),
      condExp_congr_ae (m := m) (Lp.coeFn_add f g), condExp_add hfi hgi m,
      Lp.coeFn_add (((Lp.memLp f).condExp Fact.out).toLp (μ[(f : α → ℂ) | m]))
        (((Lp.memLp g).condExp Fact.out).toLp (μ[(g : α → ℂ) | m])),
      MemLp.coeFn_toLp ((Lp.memLp f).condExp Fact.out),
      MemLp.coeFn_toLp ((Lp.memLp g).condExp Fact.out)] with x h1 h2 h3 h4 h5 h6
    rw [h1, h2, h3, h4, Pi.add_apply, Pi.add_apply, h5, h6]
  map_smul' c f := by
    ext1
    filter_upwards [MemLp.coeFn_toLp ((Lp.memLp (c • f)).condExp Fact.out),
      condExp_congr_ae (m := m) (Lp.coeFn_smul c f), condExp_smul c (f : α → ℂ) m,
      Lp.coeFn_smul c (((Lp.memLp f).condExp Fact.out).toLp (μ[(f : α → ℂ) | m])),
      MemLp.coeFn_toLp ((Lp.memLp f).condExp Fact.out)] with x h1 h2 h3 h4 h5
    rw [h1, h2, h3, RingHom.id_apply, h4, Pi.smul_apply, Pi.smul_apply, h5]

/-- The linear conditional expectation agrees a.e. with Mathlib's `μ[f | m]`. -/
theorem coeFn_condExpLpLinear (f : Lp ℂ p μ) :
    condExpLpLinear m f =ᵐ[μ] μ[(f : α → ℂ) | m] :=
  MemLp.coeFn_toLp ((Lp.memLp f).condExp Fact.out)

variable (m) in
/-- The **conditional expectation** `E[· | m]` on `L_p(μ)`, a contraction. -/
noncomputable def condExpLp : Lp ℂ p μ →L[ℝ] Lp ℂ p μ :=
  LinearMap.mkContinuous (condExpLpLinear m) 1 fun f => by
    rw [one_mul, Lp.norm_def, Lp.norm_def, eLpNorm_congr_ae (coeFn_condExpLpLinear f)]
    exact ENNReal.toReal_mono (Lp.eLpNorm_ne_top f)
      (eLpNorm_condExp_le_eLpNorm _ Fact.out)

/-- `E[f | m]` on `L_p` agrees a.e. with Mathlib's `μ[f | m]`. -/
theorem coeFn_condExpLp (f : Lp ℂ p μ) :
    condExpLp m f =ᵐ[μ] μ[(f : α → ℂ) | m] :=
  coeFn_condExpLpLinear f

variable (m) in
/-- **The conditional expectation is a contraction** on `L_p`. -/
theorem norm_condExpLp_le : ‖(condExpLp (μ := μ) (p := p) m)‖ ≤ 1 :=
  LinearMap.mkContinuous_norm_le _ zero_le_one _

variable (m) in
/-- The conditional expectation is `m`-measurable. -/
theorem condExpLp_mem_lpMeas (f : Lp ℂ p μ) :
    condExpLp m f ∈ lpMeas ℂ ℝ m p μ := by
  rw [mem_lpMeas_iff_aestronglyMeasurable]
  exact stronglyMeasurable_condExp.aestronglyMeasurable.congr (coeFn_condExpLp f).symm

/-- The conditional expectation fixes the `m`-measurable functions. -/
theorem condExpLp_of_mem (hm : m ≤ m0) {f : Lp ℂ p μ}
    (hf : f ∈ lpMeas ℂ ℝ m p μ) : condExpLp m f = f := by
  ext1
  rw [mem_lpMeas_iff_aestronglyMeasurable] at hf
  have : SigmaFinite (μ.trim hm) := inferInstance
  exact (coeFn_condExpLp f).trans
    (condExp_of_aestronglyMeasurable' hm hf ((Lp.memLp f).integrable Fact.out))

end Lp

namespace Filtration

variable (ℱ : Filtration ℕ m0)

variable (p μ) in
/-- The approximants of complexity `n` of the filtration scheme: `{0}` for `n = 0`, the
`ℱ_⌊log₂ n⌋`-measurable functions in `L_p` for `n ≥ 1`. -/
noncomputable def approximants (n : ℕ) : Submodule ℝ (Lp ℂ p μ) :=
  if n = 0 then ⊥ else lpMeas ℂ ℝ (ℱ (Nat.log 2 n)) p μ

omit [Fact (1 ≤ p)] [IsFiniteMeasure μ] in
/-- The approximants of the filtration scheme increase. -/
theorem approximants_mono : Monotone (ℱ.approximants p μ) := by
  intro a b hab f hf
  by_cases ha : a = 0
  · simp only [approximants, ha, ↓reduceIte, Submodule.mem_bot] at hf
    rw [hf]; exact Submodule.zero_mem _
  · have hb : b ≠ 0 := by omega
    simp only [approximants, ha, hb, ↓reduceIte] at hf ⊢
    rw [mem_lpMeas_iff_aestronglyMeasurable] at hf ⊢
    exact hf.mono (ℱ.mono (Nat.log_mono_right hab))

variable (p μ) in
/-- The **filtration scheme** in `L_p(μ)`. -/
noncomputable def scheme : ApproximationScheme (Lp ℂ p μ) :=
  ApproximationScheme.ofSubmodules (ℱ.approximants p μ) (by simp [approximants])
    ℱ.approximants_mono

/-- The projections of the filtration scheme: `0` for `n = 0`, `E[· | ℱ_⌊log₂ n⌋]` for
`n ≥ 1`. -/
noncomputable def proj (n : ℕ) : Lp ℂ p μ →L[ℝ] Lp ℂ p μ :=
  if n = 0 then 0 else Lp.condExpLp (ℱ (Nat.log 2 n))

/-- **The filtration scheme is a projection scheme** with bound `1`: the conditional
expectations are contractive projections onto the approximants. -/
noncomputable def projectionScheme : (ℱ.scheme p μ).ProjectionScheme where
  P := ℱ.proj
  mem n f := by
    show ℱ.proj n f ∈ ℱ.approximants p μ n
    unfold proj approximants
    split_ifs
    · simp
    · exact Lp.condExpLp_mem_lpMeas _ f
  proj n a ha := by
    change a ∈ ℱ.approximants p μ n at ha
    unfold proj
    unfold approximants at ha
    split_ifs at ha ⊢ with hn
    · rw [Submodule.mem_bot] at ha; simp [ha]
    · exact Lp.condExpLp_of_mem (ℱ.le _) ha
  bound := 1
  norm_le n := by
    unfold proj
    split_ifs
    · simp
    · exact Lp.norm_condExpLp_le _

/-- The projection of complexity `2^k` is the conditional expectation onto `ℱ_k`. -/
theorem proj_two_pow (k : ℕ) : ℱ.proj (p := p) (μ := μ) (2 ^ k) = Lp.condExpLp (ℱ k) := by
  simp only [proj, pow_ne_zero k two_ne_zero, ↓reduceIte, Nat.log_pow Nat.one_lt_two]

/-- **The martingale-difference characterisation**: for `s > 0`, `1 ≤ q ≤ ∞` and approximants
dense in `L_p`, `f ∈ A^s_q(L_p, ℱ)` iff
`‖E[f | ℱ_0]‖_p + ‖(2^(ks) ‖E[f | ℱ_{k+1}] - E[f | ℱ_k]‖_p)_k‖_{ℓ_q} < ∞`. -/
theorem memApprox_iff_martingale (hd : closure (⋃ n, ℱ.scheme p μ n) = Set.univ) {s : ℝ}
    (hs : 0 < s) {q : ℝ≥0∞} (hq : 1 ≤ q) {f : Lp ℂ p μ} :
    (ℱ.scheme p μ).MemApprox s q f ↔
      ‖Lp.condExpLp (ℱ 0) f‖ₑ + ENNReal.lqNorm q (fun k => ENNReal.dyadicWeight s k *
        ‖Lp.condExpLp (ℱ (k + 1)) f - Lp.condExpLp (ℱ k) f‖ₑ) < ∞ := by
  rw [(ℱ.projectionScheme (p := p) (μ := μ)).memApprox_iff_blockNorm_lt_top hd hs hq]
  have h1 : (ℱ.projectionScheme (p := p) (μ := μ)).P 1 = Lp.condExpLp (ℱ 0) := by
    show ℱ.proj 1 = _
    simpa using ℱ.proj_two_pow (p := p) (μ := μ) 0
  simp only [ApproximationScheme.ProjectionScheme.blockNorm,
    ApproximationScheme.ProjectionScheme.block, h1]
  change ‖_‖ₑ + ENNReal.lqNorm q (fun k => ENNReal.dyadicWeight s k *
    ‖ℱ.proj (2 ^ (k + 1)) f - ℱ.proj (2 ^ k) f‖ₑ) < ∞ ↔ _
  simp_rw [proj_two_pow]

end Filtration

end MeasureTheory
